# Neon PostgreSQL (development branch)
# Pooled connection string used by the app at runtime (Neon serverless driver).
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/devstash?sslmode=require"

# Direct (non-pooled) connection string used by Prisma CLI for migrations.
# Optional — falls back to DATABASE_URL when not set.
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/devstash?sslmode=require"

# Auth.js (NextAuth v5)
# Secret used to sign/encrypt session tokens. Generate with `npx auth secret`.
AUTH_SECRET=
# GitHub OAuth App credentials (Settings -> Developer settings -> OAuth Apps).
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Resend (https://resend.com) — used to send email-verification links.
# API key from the Resend dashboard. Required in production.
RESEND_API_KEY=
# Verified sender for outgoing mail. Falls back to Resend's test sender.
# Example: "DevStash <no-reply@yourdomain.com>"
RESEND_FROM_EMAIL=

# Absolute base URL used to build verification links.
# Falls back to AUTH_URL, then VERCEL_URL, then http://localhost:3000.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Toggle the email-verification system. Enabled by default (opt-out); set to
# "false" to let people register and sign in without a verification email.
EMAIL_VERIFICATION_ENABLED=true
